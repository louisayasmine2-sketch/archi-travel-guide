# Telegram notification credentials for the social pipeline runners.
# Copy to tools/social/.env (gitignored) and fill in.
#
# Creating the bot (BotFather):
#   1. In Telegram, open @BotFather → /newbot
#   2. Display name: anything (e.g. "Archi Pipeline")
#   3. Username: must end in "bot" (e.g. archi_pipeline_bot)
#   4. Copy the token BotFather returns → TELEGRAM_BOT_TOKEN
#   5. Send any message to your new bot (required once, opens the chat)
#   6. Open https://api.telegram.org/bot<TOKEN>/getUpdates and read
#      result[0].message.chat.id → TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Pinterest publisher (publish-pinterest.js / pinterest-auth.js).
# Registration is click-by-click in README.md → "Pinterest app registration".
# Placeholders only — never commit real values; this file is tracked.
#
# App credentials (shared by both environments, from developers.pinterest.com
# → My apps → your app → Configure):
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Must match a redirect URI registered on the app exactly, including https://.
# The page does not need to exist: only the ?code= in the address bar is used.
PINTEREST_REDIRECT_URI=https://affittacameregliarchi.com/pinterest-oauth

# Which API to talk to: sandbox (api-sandbox.pinterest.com) or production.
# Sandbox entities are separate from production and visible only to you.
PINTEREST_ENV=sandbox

# Production safety catch. The publisher refuses PINTEREST_ENV=production
# unless this reads exactly "standard" — Trial apps get 403 on pin creation.
# Set it the day the Standard access upgrade is approved, not before.
PINTEREST_ACCESS_TIER=trial

# Written by pinterest-auth.js; the publisher rotates the refresh token on
# every refresh and saves the new one. Sandbox keys carry the _SANDBOX suffix
# so both environments can be configured side by side.
PINTEREST_ACCESS_TOKEN_SANDBOX=
PINTEREST_REFRESH_TOKEN_SANDBOX=
PINTEREST_TOKEN_EXPIRES_AT_SANDBOX=
PINTEREST_REFRESH_EXPIRES_AT_SANDBOX=
PINTEREST_BOARD_ID_SANDBOX=

PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
PINTEREST_TOKEN_EXPIRES_AT=
PINTEREST_REFRESH_EXPIRES_AT=
PINTEREST_BOARD_ID=
