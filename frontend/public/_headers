# Cloudflare Pages response headers.
#
# Written after the 2026-08-09 Cloudflare report: cache hit rate 4.65%, with
# 3.3k of 7.93k requests recorded as "Dynamic" and 3.97k as "None". Cloudflare
# treats HTML and JSON as uncacheable unless told otherwise, so a fully static
# site was being served almost entirely from origin.
#
# The split below: content-hashed assets can be cached forever because their
# names change when they change; everything else revalidates with the browser
# on every request but may sit in the edge cache briefly.
#
# NOT VERIFIED against the live edge — no deploy has run since this was added.
# After the next deploy, re-check the cache-status breakdown in the Cloudflare
# dashboard; "Hit" should replace most of "Dynamic".

# Content-hashed by the build — safe to cache indefinitely.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed, but they change rarely and are replaced under the same name.
/images/*
  Cache-Control: public, max-age=2592000

# Must never be cached hard: a stale worker keeps serving an old app for as
# long as its TTL, and the user cannot clear it.
/sw.js
  Cache-Control: no-cache
/asset-manifest.json
  Cache-Control: no-cache

/manifest.json
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600

# HTML: the browser revalidates every time, the edge may hold it for ten
# minutes. A Pages deployment invalidates the edge copy, so the worst case is
# ten minutes of stale content for someone who loads a page mid-deploy.
/*
  Cache-Control: public, max-age=0, s-maxage=600, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
