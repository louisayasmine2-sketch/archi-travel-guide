# Source maps publish the app's original source. The Cloudflare report for
# 2026-08-09 had five .chunk.js.map files in the top twelve paths (333
# requests in 24 hours) — they were being scraped. CRA emits them by default
# and craco.config.js does not override it; this turns them off for
# production builds only.
GENERATE_SOURCEMAP=false

